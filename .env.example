# Copy to .env and fill in. NEVER commit .env or put these values in frontend code.

# Data centre of your Zoho org (match where you log in: .com, .eu, .in, .com.au, .jp, .ca, .sa)
ZOHO_ACCOUNTS_URL=https://accounts.zoho.eu
ZOHO_API_DOMAIN=https://www.zohoapis.eu
ZOHO_API_VERSION=v8

# From a Zoho API Console "Self Client" (see ZOHO_INTEGRATION.md, step 3)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# API names of the custom Contact fields you create in CRM
ZOHO_SERVICES_FIELD=Services_Interested_In
ZOHO_CONSENT_FIELD=Marketing_Consent

# Optional
ZOHO_LEAD_SOURCE=
ZOHO_TRIGGERS=workflow
ZOHO_CONTACT_ASSIGNMENT_RULE_ID=
ZOHO_ADD_NOTE=true

PORT=8080
# Only if the website is served from a different origin than this server
ALLOWED_ORIGIN=
